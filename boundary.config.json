{
  "$schema": "https://raw.githubusercontent.com/yzm1/boundver/v0.16.0/boundary.config.schema.json",
  "project": "boundver",
  "defaults": {
    "compat_mode": "major",
    "verify_facets": [
      "exact",
      "boundary"
    ]
  },
  "coverage": {
    "source_indicators": [
      "**/*.py"
    ],
    "exclusions": [
      {
        "paths": [
          "src/boundver/**"
        ],
        "facets": [
          "boundary"
        ],
        "reason": "Only the declared Python exports form boundver's public package boundary."
      },
      {
        "paths": [
          "spec/**"
        ],
        "facets": [
          "boundary"
        ],
        "reason": "Only the canonical lock schema and specification documents form the published format boundary."
      },
      {
        "paths": [
          "scripts/**",
          "tests/**"
        ],
        "facets": [
          "ownership"
        ],
        "reason": "Repository automation and tests support the two product components but are not independently versioned components."
      },
      {
        "paths": [
          "examples/**"
        ],
        "facets": [
          "ownership"
        ],
        "reason": "Each example is a self-contained fixture with its own boundary declaration where needed, not a product component of this repository."
      }
    ]
  },
  "components": {
    "boundver": {
      "path": "src/boundver",
      "version_source": null,
      "boundary": {
        "provider": "python-exports",
        "paths": [
          "cli.py",
          "__init__.py"
        ]
      }
    },
    "spec": {
      "path": "spec",
      "verify_facets": [
        "exact",
        "boundary"
      ],
      "consumers": [
        "boundver"
      ],
      "boundary": {
        "provider": "json-file",
        "paths": [
          "boundary.lock.schema.json",
          "derivation.schema.json",
          "HASHING.md",
          "spec.md"
        ]
      }
    }
  },
  "slices": {
    "cli-api": {
      "description": "CLI interface and public API surface",
      "mode": "boundary",
      "components": [
        "boundver"
      ]
    },
    "spec": {
      "description": "Spec documents and schemas",
      "mode": "exact",
      "components": [
        "spec"
      ]
    },
    "all": {
      "description": "Full implementation fingerprint",
      "mode": "exact",
      "components": [
        "boundver",
        "spec"
      ]
    }
  }
}
