{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yzm1/boundver/v0.15.0/spec/cli-output.why.schema.json",
  "title": "boundver why --format json output",
  "type": "object",
  "required": [
    "component", "path", "source", "lock_provenance", "version", "drifted", "observed_drift", "changes",
    "gated_facets", "gated_changes", "non_gating_changes",
    "metadata_changes", "digest_errors", "summary", "changed_files",
    "changed_files_status", "changed_files_error", "diagnostic_base", "diagnostic_base_origin",
    "boundary_paths", "provider_detail", "affected_consumers",
    "affected_components", "affected_external_consumers",
    "transitive_consumers"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"changed_files_status": {"const": "error"}},
        "required": ["changed_files_status"]
      },
      "then": {
        "properties": {
          "changed_files": {"maxItems": 0},
          "changed_files_error": {"type": "string", "minLength": 1}
        }
      },
      "else": {
        "properties": {"changed_files_error": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"changed_files_status": {"const": "not-run"}},
        "required": ["changed_files_status"]
      },
      "then": {"properties": {"changed_files": {"maxItems": 0}}}
    }
  ],
  "properties": {
    "component": {"type": "string"},
    "path": {"type": "string"},
    "source": {"type": "string", "enum": ["head", "index", "working-tree"]},
    "lock_provenance": {"type": ["string", "null"], "maxLength": 32768},
    "version": {"type": ["string", "null"]},
    "drifted": {"type": "boolean"},
    "observed_drift": {"type": "boolean"},
    "changes": {
      "type": "object",
      "propertyNames": {"enum": ["exact", "behavior", "boundary", "compat"]},
      "additionalProperties": {
        "type": "object",
        "required": ["locked", "current"],
        "additionalProperties": false,
        "properties": {
          "locked": {"type": ["string", "null"]},
          "current": {"type": ["string", "null"]}
        }
      }
    },
    "gated_facets": {
      "type": "array",
      "items": {"enum": ["exact", "behavior", "boundary", "compat"]},
      "uniqueItems": true
    },
    "gated_changes": {
      "type": "array",
      "items": {"enum": ["exact", "behavior", "boundary", "compat"]},
      "uniqueItems": true
    },
    "non_gating_changes": {
      "type": "array",
      "items": {"enum": ["exact", "behavior", "boundary", "compat"]},
      "uniqueItems": true
    },
    "metadata_changes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["locked", "current"],
        "additionalProperties": false,
        "properties": {
          "locked": true,
          "current": true
        }
      }
    },
    "digest_errors": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "path"],
        "additionalProperties": false,
        "properties": {
          "status": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "changed_files_status": {
      "type": "string",
      "enum": ["ok", "error", "not-run"],
      "description": "Whether changed-file diagnostics succeeded, failed, or were not applicable to this drift."
    },
    "changed_files_error": {
      "type": ["string", "null"],
      "description": "Diagnostic failure detail when changed_files_status is error; otherwise null."
    },
    "diagnostic_base": {"type": ["string", "null"], "maxLength": 16384},
    "diagnostic_base_origin": {"type": ["string", "null"], "maxLength": 32768},
    "boundary_paths": {"type": "array", "items": {"type": "string"}},
    "provider_detail": {"type": "string"},
    "affected_consumers": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "affected_components": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 16384},
      "uniqueItems": true
    },
    "affected_external_consumers": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "maxLength": 16384},
      "uniqueItems": true
    },
    "transitive_consumers": {"type": "boolean"}
  }
}
