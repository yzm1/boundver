{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yzm1/boundver/v0.15.1/spec/cli-output.review.schema.json",
  "title": "boundver review --format json output",
  "description": "Versioned, complete historical facet and downstream-impact analysis for two immutable Git endpoints.",
  "$defs": {
    "facet": {
      "type": "string",
      "enum": ["exact", "behavior", "boundary", "compat"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "source": {
      "type": "string",
      "enum": ["base", "target", "both"]
    },
    "changePair": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {},
        "after": {}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["requested_ref", "requested_commit", "commit", "tree", "source", "config", "lock"],
      "properties": {
        "requested_ref": { "type": "string", "minLength": 1 },
        "requested_commit": { "$ref": "#/$defs/gitOid" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "tree": { "$ref": "#/$defs/gitOid" },
        "source": { "const": "git-commit" },
        "config": { "type": "string", "minLength": 1 },
        "lock": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "facetPolicy": {
      "type": "object",
      "required": ["explicit", "defaults", "components", "slices"],
      "properties": {
        "explicit": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/facet" }, "uniqueItems": true }
          ]
        },
        "defaults": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/facet" }, "uniqueItems": true }
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/facet" },
            "uniqueItems": true
          }
        },
        "slices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["mode", "gated"],
            "properties": {
              "mode": { "$ref": "#/$defs/facet" },
              "gated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "facetTransition": {
      "type": "object",
      "required": ["facet", "before", "after", "selected"],
      "properties": {
        "facet": { "$ref": "#/$defs/facet" },
        "before": { "$ref": "#/$defs/nullableSha256" },
        "after": { "$ref": "#/$defs/nullableSha256" },
        "selected": {
          "type": "object",
          "required": ["base", "target", "effective"],
          "properties": {
            "base": { "type": "boolean" },
            "target": { "type": "boolean" },
            "effective": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "componentTransition": {
      "type": "object",
      "required": ["name", "status", "before_version", "after_version", "facets", "metadata"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["added", "removed", "changed"] },
        "before_version": { "type": ["string", "null"] },
        "after_version": { "type": ["string", "null"] },
        "facets": {
          "type": "array",
          "items": { "$ref": "#/$defs/facetTransition" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/changePair" }
        }
      },
      "additionalProperties": false
    },
    "jsonType": {
      "type": "string",
      "enum": ["object", "array", "string", "integer", "number", "boolean", "null"]
    },
    "nullableJsonType": {
      "oneOf": [
        { "$ref": "#/$defs/jsonType" },
        { "type": "null" }
      ]
    },
    "structuralInput": {
      "type": "object",
      "required": ["endpoint", "requested_ref", "requested_commit", "commit", "tree", "source", "present", "component_path", "provider", "provider_version", "boundary_digest"],
      "properties": {
        "endpoint": { "type": "string", "enum": ["base", "target"] },
        "requested_ref": { "type": "string", "minLength": 1 },
        "requested_commit": { "$ref": "#/$defs/gitOid" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "tree": { "$ref": "#/$defs/gitOid" },
        "source": { "const": "git-commit" },
        "present": { "type": "boolean" },
        "component_path": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "provider_version": { "type": ["string", "null"] },
        "boundary_digest": { "$ref": "#/$defs/nullableSha256" }
      },
      "additionalProperties": false
    },
    "structuralChange": {
      "type": "object",
      "required": ["kind", "path", "before_type", "after_type"],
      "properties": {
        "kind": { "type": "string", "enum": ["added", "removed", "changed"] },
        "path": { "type": "string", "pattern": "^(?:|(?:/(?:[^~]|~[01])*)*)$" },
        "before_type": { "$ref": "#/$defs/nullableJsonType" },
        "after_type": { "$ref": "#/$defs/nullableJsonType" }
      },
      "additionalProperties": false
    },
    "structuralDocument": {
      "type": "object",
      "required": ["label", "status", "changes"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["added", "removed", "changed"] },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/structuralChange" }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "structuralSummary": {
      "type": "object",
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "changed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "structuralReport": {
      "type": "object",
      "required": ["component", "status", "complete", "truncated", "interface", "claim", "inputs", "reason", "detail", "documents", "summary"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["complete", "unavailable"] },
        "complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "interface": { "const": "boundver-structural-diff/v1" },
        "claim": { "const": "structural-explanation-only" },
        "inputs": {
          "type": "object",
          "required": ["base", "target"],
          "properties": {
            "base": {
              "allOf": [
                { "$ref": "#/$defs/structuralInput" },
                { "properties": { "endpoint": { "const": "base" } } }
              ]
            },
            "target": {
              "allOf": [
                { "$ref": "#/$defs/structuralInput" },
                { "properties": { "endpoint": { "const": "target" } } }
              ]
            }
          },
          "additionalProperties": false
        },
        "reason": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "enum": ["component-absent", "provider-changed", "provider-version-changed", "provider-implementation-changed", "provider-unsupported", "provider-interface-unsupported", "provider-unavailable", "limit-exceeded"] }
          ]
        },
        "detail": { "type": ["string", "null"] },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/structuralDocument" } },
        "summary": { "$ref": "#/$defs/structuralSummary" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
          "then": {
            "properties": {
              "complete": { "const": true },
              "truncated": { "const": false },
              "reason": { "type": "null" },
              "detail": { "type": "null" },
              "documents": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "complete": { "const": false },
              "reason": { "type": "string" },
              "detail": { "type": "string", "minLength": 1 },
              "documents": { "maxItems": 0 },
              "summary": { "const": { "added": 0, "removed": 0, "changed": 0 } }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "structuralChanges": {
      "type": "object",
      "required": ["complete", "truncated", "interface", "claim", "reports"],
      "properties": {
        "complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "interface": { "const": "boundver-structural-diff/v1" },
        "claim": { "const": "structural-explanation-only" },
        "reports": { "type": "array", "items": { "$ref": "#/$defs/structuralReport" } }
      },
      "additionalProperties": false
    },
    "sourcedName": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "consumerEdge": {
      "type": "object",
      "required": ["from", "to", "kind", "source"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["component", "external"] },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "consumerImpact": {
      "type": "object",
      "required": ["component", "trigger_facets", "graph_changed", "transitive", "components", "external_consumers", "edges"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "trigger_facets": {
          "type": "array",
          "items": { "type": "string", "enum": ["boundary", "compat"] },
          "uniqueItems": true
        },
        "graph_changed": { "type": "boolean" },
        "transitive": { "type": "boolean" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/sourcedName" } },
        "external_consumers": { "type": "array", "items": { "$ref": "#/$defs/sourcedName" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/consumerEdge" } }
      },
      "additionalProperties": false
    },
    "sliceTransition": {
      "type": "object",
      "required": ["name", "status", "before", "after", "metadata"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["added", "removed", "changed"] },
        "before": { "$ref": "#/$defs/nullableSha256" },
        "after": { "$ref": "#/$defs/nullableSha256" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/changePair" }
        }
      },
      "additionalProperties": false
    },
    "sliceImpactComponent": {
      "type": "object",
      "required": ["name", "roles", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["changed", "consumer"] },
          "uniqueItems": true
        },
        "source": { "$ref": "#/$defs/source" }
      },
      "additionalProperties": false
    },
    "sliceImpact": {
      "type": "object",
      "required": ["name", "source", "changed", "components"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "changed": { "type": "boolean" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/sliceImpactComponent" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "complete", "request", "history", "endpoints", "policy", "metadata", "components", "structural_changes", "consumer_impact", "slices", "slice_impact", "summary"],
  "properties": {
    "schema": { "const": "boundver-review/v1" },
    "complete": { "const": true },
    "request": {
      "type": "object",
      "required": ["base", "target", "merge_base"],
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "merge_base": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["repository_shallow", "requirement"],
      "properties": {
        "repository_shallow": { "type": "boolean" },
        "requirement": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": ["base", "target"],
      "properties": {
        "base": { "$ref": "#/$defs/endpoint" },
        "target": { "$ref": "#/$defs/endpoint" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["compared_facets", "explicit_facets", "impact", "base", "target"],
      "properties": {
        "compared_facets": {
          "const": ["exact", "behavior", "boundary", "compat"]
        },
        "explicit_facets": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/facet" }, "uniqueItems": true }
          ]
        },
        "impact": { "type": "string", "enum": ["direct", "transitive"] },
        "base": { "$ref": "#/$defs/facetPolicy" },
        "target": { "$ref": "#/$defs/facetPolicy" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "project": { "$ref": "#/$defs/changePair" },
        "config_contract": { "$ref": "#/$defs/changePair" },
        "config_digest": { "$ref": "#/$defs/changePair" }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "required": ["changed", "unchanged"],
      "properties": {
        "changed": { "type": "array", "items": { "$ref": "#/$defs/componentTransition" } },
        "unchanged": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "structural_changes": { "$ref": "#/$defs/structuralChanges" },
    "consumer_impact": { "type": "array", "items": { "$ref": "#/$defs/consumerImpact" } },
    "slices": {
      "type": "object",
      "required": ["changed", "unchanged"],
      "properties": {
        "changed": { "type": "array", "items": { "$ref": "#/$defs/sliceTransition" } },
        "unchanged": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "slice_impact": { "type": "array", "items": { "$ref": "#/$defs/sliceImpact" } },
    "summary": {
      "type": "object",
      "required": ["changed_components", "consumer_impacts", "changed_slices", "impacted_slices"],
      "properties": {
        "changed_components": { "type": "integer", "minimum": 0 },
        "consumer_impacts": { "type": "integer", "minimum": 0 },
        "changed_slices": { "type": "integer", "minimum": 0 },
        "impacted_slices": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
