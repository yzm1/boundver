{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yzm1/boundver/v0.15.2/spec/cli-output.plan.schema.json",
  "title": "boundver review --format plan output",
  "description": "A complete CI routing projection of one immutable boundver range review. It is routing evidence, not a backward-compatibility verdict.",
  "$defs": {
    "facet": {
      "type": "string",
      "enum": ["exact", "behavior", "boundary", "compat"]
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "source": {
      "type": "string",
      "enum": ["base", "target", "both"]
    },
    "endpoint": {
      "type": "object",
      "required": ["requested_ref", "requested_commit", "commit", "tree", "source", "config", "lock"],
      "properties": {
        "requested_ref": {"type": "string", "minLength": 1},
        "requested_commit": {"$ref": "#/$defs/gitOid"},
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"},
        "source": {"const": "git-commit"},
        "config": {"type": "string", "minLength": 1},
        "lock": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "facetPolicy": {
      "type": "object",
      "required": ["explicit", "defaults", "components", "slices"],
      "properties": {
        "explicit": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/facet"}, "uniqueItems": true}
          ]
        },
        "defaults": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/facet"}, "uniqueItems": true}
          ]
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"$ref": "#/$defs/facet"},
            "uniqueItems": true
          }
        },
        "slices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["mode", "gated"],
            "properties": {
              "mode": {"$ref": "#/$defs/facet"},
              "gated": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "selectedPolicy": {
      "type": "object",
      "required": ["base", "target", "effective"],
      "properties": {
        "base": {"type": "boolean"},
        "target": {"type": "boolean"},
        "effective": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "changedComponent": {
      "type": "object",
      "required": ["name", "status", "facets", "metadata"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["added", "removed", "changed"]},
        "facets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["facet", "selected"],
            "properties": {
              "facet": {"$ref": "#/$defs/facet"},
              "selected": {"$ref": "#/$defs/selectedPolicy"}
            },
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "sourcedName": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "consumerEdge": {
      "type": "object",
      "required": ["from", "to", "kind", "source"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["component", "external"]},
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "consumerImpact": {
      "type": "object",
      "required": ["component", "trigger_facets", "graph_changed", "transitive", "components", "external_consumers", "edges"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "trigger_facets": {
          "type": "array",
          "items": {"type": "string", "enum": ["boundary", "compat"]},
          "uniqueItems": true
        },
        "graph_changed": {"type": "boolean"},
        "transitive": {"type": "boolean"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/sourcedName"}},
        "external_consumers": {"type": "array", "items": {"$ref": "#/$defs/sourcedName"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/consumerEdge"}}
      },
      "additionalProperties": false
    },
    "changedSlice": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["added", "removed", "changed"]}
      },
      "additionalProperties": false
    },
    "sliceImpactComponent": {
      "type": "object",
      "required": ["name", "roles", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "roles": {
          "type": "array",
          "items": {"type": "string", "enum": ["changed", "consumer"]},
          "uniqueItems": true
        },
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "sliceImpact": {
      "type": "object",
      "required": ["name", "source", "changed", "components"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "changed": {"type": "boolean"},
        "components": {"type": "array", "items": {"$ref": "#/$defs/sliceImpactComponent"}}
      },
      "additionalProperties": false
    },
    "jsonType": {
      "type": "string",
      "enum": ["object", "array", "string", "integer", "number", "boolean", "null"]
    },
    "nullableJsonType": {
      "oneOf": [{"$ref": "#/$defs/jsonType"}, {"type": "null"}]
    },
    "structuralInput": {
      "type": "object",
      "required": ["endpoint", "requested_ref", "requested_commit", "commit", "tree", "source", "present", "component_path", "provider", "provider_version", "boundary_digest"],
      "properties": {
        "endpoint": {"type": "string", "enum": ["base", "target"]},
        "requested_ref": {"type": "string", "minLength": 1},
        "requested_commit": {"$ref": "#/$defs/gitOid"},
        "commit": {"$ref": "#/$defs/gitOid"},
        "tree": {"$ref": "#/$defs/gitOid"},
        "source": {"const": "git-commit"},
        "present": {"type": "boolean"},
        "component_path": {"type": ["string", "null"]},
        "provider": {"type": ["string", "null"]},
        "provider_version": {"type": ["string", "null"]},
        "boundary_digest": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "structuralChange": {
      "type": "object",
      "required": ["kind", "path", "before_type", "after_type"],
      "properties": {
        "kind": {"type": "string", "enum": ["added", "removed", "changed"]},
        "path": {"type": "string", "pattern": "^(?:|(?:/(?:[^~]|~[01])*)*)$"},
        "before_type": {"$ref": "#/$defs/nullableJsonType"},
        "after_type": {"$ref": "#/$defs/nullableJsonType"}
      },
      "additionalProperties": false
    },
    "structuralDocument": {
      "type": "object",
      "required": ["label", "status", "changes"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["added", "removed", "changed"]},
        "changes": {"type": "array", "items": {"$ref": "#/$defs/structuralChange"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "structuralSummary": {
      "type": "object",
      "required": ["added", "removed", "changed"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "changed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "structuralReport": {
      "type": "object",
      "required": ["component", "status", "complete", "truncated", "interface", "claim", "inputs", "reason", "detail", "documents", "summary"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["complete", "unavailable"]},
        "complete": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "interface": {"const": "boundver-structural-diff/v1"},
        "claim": {"const": "structural-explanation-only"},
        "inputs": {
          "type": "object",
          "required": ["base", "target"],
          "properties": {
            "base": {"$ref": "#/$defs/structuralInput"},
            "target": {"$ref": "#/$defs/structuralInput"}
          },
          "additionalProperties": false
        },
        "reason": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "enum": ["component-absent", "provider-changed", "provider-version-changed", "provider-implementation-changed", "provider-unsupported", "provider-interface-unsupported", "provider-unavailable", "limit-exceeded"]}
          ]
        },
        "detail": {"type": ["string", "null"]},
        "documents": {"type": "array", "items": {"$ref": "#/$defs/structuralDocument"}},
        "summary": {"$ref": "#/$defs/structuralSummary"}
      },
      "additionalProperties": false
    },
    "structuralChanges": {
      "type": "object",
      "required": ["complete", "truncated", "interface", "claim", "reports"],
      "properties": {
        "complete": {"type": "boolean"},
        "truncated": {"type": "boolean"},
        "interface": {"const": "boundver-structural-diff/v1"},
        "claim": {"const": "structural-explanation-only"},
        "reports": {"type": "array", "items": {"$ref": "#/$defs/structuralReport"}}
      },
      "additionalProperties": false
    },
    "nameArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "type": "object",
  "required": ["schema", "complete", "claim", "request", "history", "endpoints", "policy", "changed_components", "consumer_impact", "changed_slices", "slice_impact", "structural_changes", "selection", "source_locations", "summary"],
  "properties": {
    "schema": {"const": "boundver-plan/v1"},
    "complete": {"const": true},
    "claim": {"const": "routing-evidence-only"},
    "request": {
      "type": "object",
      "required": ["base", "target", "merge_base"],
      "properties": {
        "base": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "merge_base": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "required": ["repository_shallow", "requirement"],
      "properties": {
        "repository_shallow": {"type": "boolean"},
        "requirement": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "object",
      "required": ["base", "target"],
      "properties": {
        "base": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["compared_facets", "explicit_facets", "impact", "base", "target"],
      "properties": {
        "compared_facets": {"const": ["exact", "behavior", "boundary", "compat"]},
        "explicit_facets": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/facet"}, "uniqueItems": true}
          ]
        },
        "impact": {"type": "string", "enum": ["direct", "transitive"]},
        "base": {"$ref": "#/$defs/facetPolicy"},
        "target": {"$ref": "#/$defs/facetPolicy"}
      },
      "additionalProperties": false
    },
    "changed_components": {"type": "array", "items": {"$ref": "#/$defs/changedComponent"}},
    "consumer_impact": {"type": "array", "items": {"$ref": "#/$defs/consumerImpact"}},
    "changed_slices": {"type": "array", "items": {"$ref": "#/$defs/changedSlice"}},
    "slice_impact": {"type": "array", "items": {"$ref": "#/$defs/sliceImpact"}},
    "structural_changes": {"$ref": "#/$defs/structuralChanges"},
    "selection": {
      "type": "object",
      "required": ["changed_components", "impacted_components", "external_consumers", "test_components", "changed_slices", "impacted_slices", "test_slices"],
      "properties": {
        "changed_components": {"$ref": "#/$defs/nameArray"},
        "impacted_components": {"$ref": "#/$defs/nameArray"},
        "external_consumers": {"$ref": "#/$defs/nameArray"},
        "test_components": {"$ref": "#/$defs/nameArray"},
        "changed_slices": {"$ref": "#/$defs/nameArray"},
        "impacted_slices": {"$ref": "#/$defs/nameArray"},
        "test_slices": {"$ref": "#/$defs/nameArray"}
      },
      "additionalProperties": false
    },
    "source_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component", "path", "endpoint", "commit", "kind"],
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "enum": ["base", "target"]},
          "commit": {"$ref": "#/$defs/gitOid"},
          "kind": {"const": "structural-document"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["changed_components", "impacted_components", "external_consumers", "test_components", "changed_slices", "impacted_slices", "test_slices", "structural_reports", "structural_complete"],
      "properties": {
        "changed_components": {"type": "integer", "minimum": 0},
        "impacted_components": {"type": "integer", "minimum": 0},
        "external_consumers": {"type": "integer", "minimum": 0},
        "test_components": {"type": "integer", "minimum": 0},
        "changed_slices": {"type": "integer", "minimum": 0},
        "impacted_slices": {"type": "integer", "minimum": 0},
        "test_slices": {"type": "integer", "minimum": 0},
        "structural_reports": {"type": "integer", "minimum": 0},
        "structural_complete": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
