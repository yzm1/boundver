{
  "$schema": "https://raw.githubusercontent.com/yzm1/boundver/v0.13.0/boundary.config.schema.json",
  "project": "example-python-package",
  "components": {
    "pkg": {
      "path": "examples/python-package/pkg",
      "version_source": {"file": "version.json", "field": "version"},
      "boundary": {"provider": "python-exports", "paths": ["__init__.py"]}
    }
  },
  "slices": {
    "pkg-boundary": {"mode": "boundary", "components": ["pkg"]}
  }
}
