{
  "$schema": "https://raw.githubusercontent.com/yzm1/boundver/v0.14.0/boundary.config.schema.json",
  "project": "example-typescript-package",
  "components": {
    "pkg": {
      "path": "examples/typescript-package/src",
      "version_source": {"file": "version.json", "field": "version"},
      "boundary": {"provider": "typescript-exports", "paths": ["index.ts"]}
    }
  },
  "slices": {
    "pkg-boundary": {"mode": "boundary", "components": ["pkg"]}
  }
}
