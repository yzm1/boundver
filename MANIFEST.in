include CHANGELOG.md
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include SUPPORT.md
include boundary.config.schema.json
recursive-include docs *.md
exclude docs/RELEASING.md
exclude docs/documentation-style.md
exclude docs/hashing-contract.md
exclude docs/specification.md
exclude docs/support.md
exclude docs/design/obligation-survey-method.md
exclude docs/design/obligation-survey-reply.md
exclude docs/design/obligation-survey-reply-2.md
exclude docs/design/testing-obligations.md
recursive-include examples *.json *.md *.py *.toml *.ts *.yaml
recursive-include spec *.json *.md
exclude spec/mutants.json
exclude spec/release-mutations.json
exclude spec/testing-obligations.json
exclude spec/test-tiers.json

# Setuptools may add conventional test files automatically. Keep the source
# distribution deliberately user-facing rather than turning it into a partial
# repository snapshot.
prune tests
prune scripts
prune .github
exclude .dockerignore
exclude .gitattributes
exclude .gitignore
exclude .pre-commit-hooks.yaml
exclude Dockerfile
exclude action.yml
exclude boundary.config.json
exclude boundary.lock.json
