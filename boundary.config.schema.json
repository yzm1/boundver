{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yzm1/boundver/v0.14.0/boundary.config.schema.json",
  "title": "boundver config",
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!\\s)(?!.*\\s$).+$"
    }
  },
  "type": "object",
  "required": ["project", "components"],
  "properties": {
    "$schema": {"type": "string"},
    "project": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array",
      "maxItems": 100,
      "description": "Custom providers. Loading requires an explicit --allow-custom-providers flag or trusted environment opt-in.",
      "items": {
        "type": "object",
        "required": ["module", "class"],
        "properties": {
          "module": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "name": {"type": "string", "pattern": "^custom\\..*\\S$"}
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "compat_mode": {
          "type": "string",
          "enum": ["major", "semver_major", "semver_major_minor"]
        },
        "verify_facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["exact", "behavior", "boundary", "compat"]
          }
        }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "required": ["path", "boundary"],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "ecosystem": {"type": "string"},
          "note": {
            "type": "string",
            "description": "Human-facing component context; does not affect semantic configuration identity."
          },
          "version_source": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["file", "field"],
                "properties": {
                  "file": {"$ref": "#/$defs/relativePath"},
                  "field": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["git_tag_prefix"],
                "properties": {
                  "git_tag_prefix": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            ]
          },
          "boundary": {
            "type": "object",
            "required": ["provider"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "paths": {
                "type": "array",
                "maxItems": 50000,
                "items": {"$ref": "#/$defs/relativePath"}
              },
              "options": {
                "type": "object",
                "description": "Provider-specific options passed through ProviderContext.",
                "additionalProperties": true
              },
              "note": {"type": "string"}
            },
            "additionalProperties": false
          },
          "behavior": {
            "type": "object",
            "description": "Behavior-relevant paths, normally a superset of boundary paths.",
            "properties": {
              "paths": {
                "type": "array",
                "maxItems": 50000,
                "items": {"$ref": "#/$defs/relativePath"}
              }
            },
            "additionalProperties": false
          },
          "vendored_copies": {
            "type": "array",
            "items": {"$ref": "#/$defs/relativePath"}
          },
          "consumers": {
            "type": "array",
            "description": "Configured component names directly downstream of this component.",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "external_consumers": {
            "type": "array",
            "description": "Opaque terminal labels for downstream systems not configured as components.",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "verify_facets": {
            "type": "array",
            "description": "Component-specific gated facets used when --facets is not passed.",
            "items": {"type": "string", "enum": ["exact", "behavior", "boundary", "compat"]},
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "slices": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "mode": {"type": "string", "enum": ["exact", "behavior", "boundary", "compat"]},
          "components": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "closure_of": {
            "type": "string",
            "minLength": 1,
            "description": "Include this component and its transitive downstream consumers."
          }
        },
        "oneOf": [
          {"required": ["components"]},
          {"required": ["closure_of"]}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
